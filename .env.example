# Local development schema. Replace every changethis* value before deployment.
# The Makefile development wrapper overrides local project names, host URLs,
# image names, and published ports deterministically from DEV_SLOT.
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
ENABLE_PRIVATE_TEST_API=false
PROJECT_NAME="NeoMua"
STACK_NAME=neomua
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SECRET_KEY=changethis-secret-key
INTERNAL_RUNTIME_TOKEN=changethis-runtime-service-token
# Development-only trust root. Deployments must inject the immutable worker image digest.
RUNTIME_WORKER_RELEASE_DIGEST=fa234853403a30bb56389320ed5b95bce17fba62f68a8c4a09cb9835e0628f25
MODEL_GATEWAY_PUBLIC_URL=http://localhost:8090
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
SENTRY_DSN=
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
